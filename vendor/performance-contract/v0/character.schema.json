{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoacoustics.local/contracts/performance/v0/character.schema.json",
  "title": "CharacterSpec v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "character_id", "revision", "name"],
  "properties": {
    "schema_version": {"const": "performance-contract/v0"},
    "character_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "default_controls": {"$ref": "common.schema.json#/$defs/directionControls"}
  }
}
