{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoacoustics.local/contracts/performance/v0/performance-result.schema.json",
  "title": "PerformanceResult v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "performance_id", "request_id", "take_id", "job_status", "artifacts", "diagnostics", "provenance"],
  "properties": {
    "schema_version": {"const": "performance-contract/v0"},
    "performance_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "take_id": {"type": "string", "minLength": 1},
    "job_status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]},
    "realization_outcome": {"enum": ["FEASIBLE", "INFEASIBLE", "UNSUPPORTED", "INVALID"]},
    "artifacts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact"}},
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "start_seconds", "end_seconds"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "start_seconds": {"type": "number", "minimum": 0.0},
          "end_seconds": {"type": "number", "minimum": 0.0}
        }
      }
    },
    "diagnostics": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/diagnostic"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "backend_version", "contract_version", "seed", "input_digest"],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "backend_version": {"type": "string", "minLength": 1},
        "contract_version": {"const": "performance-contract/v0"},
        "seed": {"type": "integer", "minimum": 0},
        "input_digest": {"type": "string", "minLength": 1},
        "input_digest_algorithm": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"job_status": {"const": "SUCCEEDED"}}, "required": ["job_status"]},
      "then": {"required": ["realization_outcome"]}
    }
  ]
}
