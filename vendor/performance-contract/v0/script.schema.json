{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphoacoustics.local/contracts/performance/v0/script.schema.json",
  "title": "Script v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "script_id", "revision", "segments"],
  "properties": {
    "schema_version": {"const": "performance-contract/v0"},
    "script_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "speaker_character_id", "text"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "speaker_character_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
